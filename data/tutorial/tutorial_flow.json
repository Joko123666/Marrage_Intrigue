{
  "schema_version": "0.1",
  "flow_id": "tutorial_knight_to_nobility",
  "goal_ko": "평민 고아에서 기사와의 결혼을 통해 귀족 사회 진입까지 경험시킨다.",
  "steps": [
    {
      "id": "start_slum",
      "week": 1,
